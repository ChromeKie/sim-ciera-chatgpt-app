PORT=8787
SIM_CIERA_DATA_FILE=./data/store.json
# Optional production UI domain for resource metadata, e.g. https://sim-ciera.example.com
SIM_CIERA_UI_DOMAIN=

# Set all three together for durable hosted storage. Local runs can leave them blank.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Generate a private UUID for this Sim-Ciera installation; never put it in frontend code.
SIM_CIERA_STORE_ID=
